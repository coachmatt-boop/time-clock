<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Who's In</title><style>body{font-family:Arial,sans-serif;background:#f4f6f8;margin:0;color:#111}.wrap{max-width:760px;margin:auto;padding:22px}.logo{width:240px;max-height:80px;object-fit:contain;display:block;margin:0 auto 22px}h1{margin:0 0 6px;text-align:center}#count{font-size:24px;font-weight:700;text-align:center;margin-bottom:20px}.person{background:#fff;padding:16px 18px;margin:10px 0;border-radius:12px;box-shadow:0 3px 12px rgba(0,0,0,.07)}.name{font-weight:700;font-size:20px}.time{color:#666;margin-top:4px}#updated{text-align:center;color:#777;margin-top:18px;font-size:14px}</style></head><body><div class="wrap"><img class="logo" src="https://illusiondc.com/wp-content/uploads/2025/09/IDC_Primary-Logo-Black.svg" alt="Illusion"><h1>WHO'S IN</h1><div id="count">Loading…</div><div id="list"></div><div id="updated"></div></div><script>const URL="https://script.google.com/macros/s/AKfycbz-ffNozIKCHgojWoIKgeW-mxhrgGK3f50IdMHcEOsVBdK6vBU9WBq-l0E3SpQ2G_jlFQ/exec";function load(){let cb='__wi_'+Date.now();window[cb]=d=>{document.getElementById('count').textContent=d.count+' currently in';let list=document.getElementById('list');list.innerHTML='';d.people.forEach(p=>{let x=document.createElement('div');x.className='person';x.innerHTML='<div class="name"></div><div class="time"></div>';x.querySelector('.name').textContent=p.name;x.querySelector('.time').textContent=p.lastClock||'';list.appendChild(x)});document.getElementById('updated').textContent='Updated '+d.refreshed;document.getElementById(cb).remove();delete window[cb]};let s=document.createElement('script');s.id=cb;s.src=URL+'?action=whosin&callback='+cb+'&_='+Date.now();document.body.appendChild(s)}load();setInterval(load,30000);</script></body></html>
